{
	"name": "saive-obsidian",
	"version": "0.0.1",
	"description": "Sync your Saive library into your vault as Markdown notes.",
	"private": true,
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"lint": "eslint .",
		"check:reproducible": "node scripts/check-reproducible.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.1"
	}
}
